# Cricket Vault Environment Configuration
# Copy this file to .env and adjust credentials as appropriate.

PROJECT_NAME="Cricket Vault API"
SECRET_KEY="cricket_vault_super_secret_jwt_key_2026"
ALGORITHM="HS256"

# Database Configuration (Defaults to persistent MongoMock if MongoDB server is offline)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="cricket_vault_db"

# Cricket Live Data API Configuration
# Supported providers: 'cricapi' (https://cricapi.com), 'cricketdata' (https://cricketdata.org)
# Leave empty to utilize the verified real-world cricket feed with automatic failover
CRICKET_DATA_API_KEY=""
CRICKET_API_PROVIDER="cricapi"
CRICKET_CACHE_TTL_SECONDS=30

# Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_cricketvault_demo"
RAZORPAY_KEY_SECRET="cricketvault_secret_demo"
MOCK_PAYMENTS=true
